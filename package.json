{
  "name": "invest-moz",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "preview": "node scripts/serve-dist.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "check:data": "node scripts/validate-data.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ortho": "node scripts/check-orthography.mjs",
    "check": "npm run check:data && npm run check:i18n && npm run check:ortho",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run check && npm run build",
    "data:schemas": "node scripts/build-schemas.mjs",
    "data:confirm": "node scripts/content-to-confirm.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^9.39.5",
    "@lucide/angular": "^1.59.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
