{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-apiex.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fxUsdMzn",
    "fdiMinimumMzn",
    "regime",
    "fdiGuarantee"
  ],
  "properties": {
    "fxUsdMzn": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fdiMinimumMzn": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "regime": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold",
              "authority",
              "path",
              "refs"
            ],
            "properties": {
              "threshold": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "authority": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "path": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            }
          }
        }
      }
    },
    "fdiGuarantee": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "common.schema.json#/definitions/localizedText"
              }
            }
          }
        }
      }
    }
  }
}
