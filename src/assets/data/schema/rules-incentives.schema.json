{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-incentives.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["incentives"],
  "properties": {
    "incentives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "then"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "detail", "conditions", "refs"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "detail": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "conditions": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
