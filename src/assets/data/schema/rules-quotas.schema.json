{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-quotas.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minPercent",
    "maxPercent",
    "bands"
  ],
  "properties": {
    "minPercent": {
      "type": "number"
    },
    "maxPercent": {
      "type": "number"
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minWorkers",
          "percent"
        ],
        "properties": {
          "minWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "percent": {
            "type": "number"
          }
        }
      },
      "minItems": 1
    }
  }
}
