{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-licences.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "licences"
  ],
  "properties": {
    "licences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "title",
              "detail",
              "authority",
              "refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "bau",
                  "sector",
                  "environmental",
                  "duat",
                  "other"
                ]
              },
              "title": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "detail": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "authority": {
                "$ref": "common.schema.json#/definitions/localizedText"
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
