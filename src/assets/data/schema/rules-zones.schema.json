{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-zones.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corridors",
    "location",
    "financing",
    "esg"
  ],
  "properties": {
    "corridors": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/province"
      },
      "additionalProperties": {
        "enum": [
          "nacala",
          "beira",
          "maputo",
          "none"
        ]
      }
    },
    "location": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "$ref": "common.schema.json#/definitions/note"
          }
        }
      }
    },
    "financing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "$ref": "common.schema.json#/definitions/note"
          }
        }
      }
    },
    "esg": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/definitions/condition"
            }
          },
          "then": {
            "$ref": "common.schema.json#/definitions/note"
          }
        }
      }
    }
  }
}
