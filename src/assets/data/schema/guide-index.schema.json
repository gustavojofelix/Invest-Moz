{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "guide-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lastReviewed",
    "sources",
    "chapters"
  ],
  "properties": {
    "lastReviewed": {
      "$ref": "common.schema.json#/definitions/isoDate"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "refId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      },
      "minItems": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "sources"
        ],
        "properties": {
          "id": {
            "enum": [
              "at-a-glance",
              "why-mozambique",
              "sectors",
              "investment-law",
              "company-setup",
              "roadmap",
              "zones",
              "tax",
              "people",
              "exchange",
              "land-esg",
              "protection"
            ]
          },
          "title": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "summary": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "topic": {
            "$ref": "common.schema.json#/definitions/topic"
          }
        }
      },
      "minItems": 12,
      "maxItems": 12
    }
  }
}
