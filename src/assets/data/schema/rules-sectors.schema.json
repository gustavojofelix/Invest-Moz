{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-sectors.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fallback", "sectors"],
  "properties": {
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "envCategory", "keywords"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "envCategory": {
            "enum": ["A", "B", "C"]
          },
          "keywords": {
            "$ref": "common.schema.json#/definitions/localizedKeywords"
          }
        }
      }
    }
  }
}
