{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-base.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "references"
  ],
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "instrument",
          "title",
          "summary",
          "lastReviewed",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "topic": {
            "$ref": "common.schema.json#/definitions/topic"
          },
          "instrument": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "summary": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "excerpt": {
            "$ref": "common.schema.json#/definitions/localizedText"
          },
          "lastReviewed": {
            "$ref": "common.schema.json#/definitions/isoDate"
          },
          "status": {
            "enum": [
              "illustrative",
              "verified"
            ]
          }
        }
      }
    }
  }
}
